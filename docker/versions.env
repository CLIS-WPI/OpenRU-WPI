# Pinned upstream versions for reproducible OpenRU builds.
# Host-specific GPU UUID / cpusets / MARCH live in docker/lab.env (see lab.env.example).

PROTORU_GIT_URL=https://github.com/CLIS-WPI/ProtO-RU.git
PROTORU_GIT_BRANCH=openru/main
PROTORU_GIT_COMMIT=45dbc958f810de00b7ff0d6f2f719d502704263c
PROTORU_TAG=v26.04.0-2-g45dbc958f8

# CUDA / container base (driver on host supports CUDA 13.0; toolkit in image is 12.6)
CUDA_IMAGE=nvidia/cuda:12.6.0-devel-ubuntu24.04
CUDA_RUNTIME_IMAGE=nvidia/cuda:12.6.0-runtime-ubuntu24.04
OS_VERSION=24.04
UHD_VERSION=4.7.0.0
DPDK_VERSION=24.11.2
OPEN5GS_VERSION=v2.7.6
OPENRU_TAG=m0

# Generic build default when lab.env is absent from CI image builds only.
# Runtime compose/preflight still require lab.env for GPU/cpuset.
MARCH_DEFAULT=x86-64-v3
