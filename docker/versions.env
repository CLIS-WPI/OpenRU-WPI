# Pinned upstream versions for reproducible OpenRU builds.
# GPU lane: this host pins ProtO-RU / CUDA work to H100 GPU 1 only.

PROTORU_GIT_URL=https://github.com/NUS-CIR/ProtO-RU.git
PROTORU_GIT_BRANCH=proto-ru
PROTORU_GIT_COMMIT=45dbc958f810de00b7ff0d6f2f719d502704263c
PROTORU_TAG=v26.04.0-2-g45dbc958f8

# CUDA / container base (driver on host supports CUDA 13.0; toolkit in image is 12.6)
CUDA_IMAGE=nvidia/cuda:12.6.0-devel-ubuntu24.04
CUDA_RUNTIME_IMAGE=nvidia/cuda:12.6.0-runtime-ubuntu24.04
OS_VERSION=24.04
UHD_VERSION=4.7.0.0
DPDK_VERSION=24.11.2
OPEN5GS_VERSION=v2.7.6
OPENRU_TAG=m0

# --- GPU1 lane (fail-closed) ---
# Host index 1 = NVIDIA H100 NVL
OPENRU_GPU_INDEX=1
OPENRU_GPU_UUID=GPU-509d8ab3-0c8e-8b98-fbf8-0c55f6ba9058
OPENRU_FORBIDDEN_GPU_UUID=GPU-96b18ccc-7894-5e31-0ad6-a74b5b79ac28

# CPU pinning for ProtO-RU (NUMA node 1 cores; leave node 0 for other workloads)
PROTORU_CPUSET=32-47
DU_CPUSET=48-55
