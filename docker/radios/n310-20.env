# Bench radio n310-20 (selected with BENCH_RADIO=n310-20; loaded after docker/bench.env by scripts/radio_env.sh).
# Used for the 2x2 bench stage (2026-11-20): probe-verified serial, HG FPGA, MPM 4.11.0.0.
# Radio NIC: X710 port on the N310 management/IQ subnet (host address .1/24).
BENCH_FH_IFACE=enp5s0f2np2
BENCH_USRP_HOST_IP=192.168.20.1/24
BENCH_USRP_SERIAL=33CF5B2
BENCH_USRP_ADDR=192.168.20.2
BENCH_MGMT_ADDR=192.168.20.2
# ProtO-RU's macvlan on that NIC; restart-ru probes from BENCH_PROBE_IP (never .2, the N310).
BENCH_RADIO_SUBNET=192.168.20.0/24
BENCH_RADIO_GATEWAY=192.168.20.1
BENCH_RU_IP=192.168.20.3
BENCH_PROBE_IP=192.168.20.4
