# Bench radio n310-30 (selected with BENCH_RADIO=n310-30; loaded after docker/bench.env by scripts/radio_env.sh).
# [UNVERIFIED] Never run: NIC and subnet follow the lab inventory pattern; serial unknown (set it before use).
# Radio NIC: X710 port on the N310 management/IQ subnet (host address .1/24).
BENCH_FH_IFACE=enp5s0f3np3
BENCH_USRP_HOST_IP=192.168.30.1/24
BENCH_USRP_SERIAL=
BENCH_USRP_ADDR=192.168.30.2
BENCH_MGMT_ADDR=192.168.30.2
# ProtO-RU's macvlan on that NIC; restart-ru probes from BENCH_PROBE_IP (never .2, the N310).
BENCH_RADIO_SUBNET=192.168.30.0/24
BENCH_RADIO_GATEWAY=192.168.30.1
BENCH_RU_IP=192.168.30.3
BENCH_PROBE_IP=192.168.30.4
