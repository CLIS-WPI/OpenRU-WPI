# Copy to docker/lab.env (gitignored) and fill in host-specific values.
# make preflight fails if lab.env is missing.

# --- GPU lane (fail-closed) ---
# Use nvidia-smi -L. Never use --gpus all.
OPENRU_GPU_INDEX=1
OPENRU_GPU_UUID=GPU-509d8ab3-0c8e-8b98-fbf8-0c55f6ba9058
OPENRU_FORBIDDEN_GPU_UUID=GPU-96b18ccc-7894-5e31-0ad6-a74b5b79ac28

# --- CPU pinning (this lab host) ---
# AMD EPYC 9354 ×2; SMT off (threads/core=1). thread_siblings_list is singleton —
# CPUs 32–63 are NOT SMT siblings of 0–31; they are socket1 / NUMA1 physical cores.
# GPU0+GPU1 PCI are on NUMA0 (local_cpulist=0-31). An experimental pin of
# ProtO-RU/DU onto NUMA0 (16-27 / 28-31) raised the 600 s late ratio from
# ~4.9e-6 to ~6.6e-5 [MEASURED] — worse for OFH. Keep OFH on NUMA1 for the
# Phase 1 CPU baseline; revisit for CUDA (M2) if H2D locality dominates.
PROTORU_CPUSET=32-47
DU_CPUSET=48-55
# ProtO-RU yaml timing/ofh workers must sit inside PROTORU_CPUSET.

# --- Build ---
# Published/generic images: x86-64-v3. Override per host only in lab.env.
MARCH=x86-64-v3
