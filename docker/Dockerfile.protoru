# OpenRU ProtO-RU image. Build context = openru-sw/ repo root.
# Layering: copy only docker/scripts before deps+UHD/DPDK so source edits do not
# invalidate those expensive layers. Full tree is ADDed only before builder.sh.
# syntax=docker/dockerfile:1.6

ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:12.6.0-runtime-ubuntu24.04
ARG OS_VERSION=24.04
ARG UHD_VERSION=4.7.0.0
ARG DPDK_VERSION=24.11.2
ARG MARCH=x86-64-v3
ARG NUM_JOBS=32
ARG TARGETARCH
ARG COMPILER=gcc
ARG EXTRA_CMAKE_ARGS="-DOPENRU_CUDA=OFF"
# Full default matches upstream; set OCUDU_BUILD_TARGETS="gnb ru_emulator" for a faster warm rebuild.
ARG OCUDU_BUILD_TARGETS="ocu odu odu_split_8 odu_split_7_2 gnb gnb_split_8 gnb_split_7_2 ru_emulator"

# --- Stage: OS + build deps (invalidates only when install scripts change) ---
FROM ubuntu:${OS_VERSION} AS builder-base
COPY external/proto-ru/docker/scripts /src/docker/scripts
RUN /src/docker/scripts/install_dependencies.sh build && \
    /src/docker/scripts/install_uhd_dependencies.sh build && \
    /src/docker/scripts/install_dpdk_dependencies.sh build && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git clang ccache && \
    ccache --set-config=max_size=20G

# --- Stage: UHD + DPDK (invalidates only when scripts/versions/MARCH change) ---
FROM builder-base AS builder-deps
ARG UHD_VERSION
ARG DPDK_VERSION
ARG MARCH
ARG NUM_JOBS
ARG TARGETARCH
RUN mkdir -p /opt/rohc
RUN UHD_ARCH=$([ "${TARGETARCH}" = "arm64" ] && echo "-mcpu=${MARCH}" || echo "-march=${MARCH}") && \
    DPDK_PLATFORM=$(case "${MARCH}" in *neoverse-n1*) echo n1sdp ;; *) echo "${MARCH}" ;; esac) && \
    DPDK_ARCH=$([ "${TARGETARCH}" = "arm64" ] && echo "-Dplatform=${DPDK_PLATFORM} -Dmax_numa_nodes=1" || echo "-Dcpu_instruction_set=${MARCH}") && \
    /src/docker/scripts/build_uhd.sh "${UHD_VERSION}" ${UHD_ARCH} ${NUM_JOBS} && \
    /src/docker/scripts/build_dpdk.sh "${DPDK_VERSION}" "${DPDK_ARCH}" ${NUM_JOBS}
ENV UHD_DIR=/opt/uhd/${UHD_VERSION}
ENV DPDK_DIR=/opt/dpdk/${DPDK_VERSION}

# --- Stage: OCUDU/ProtO-RU compile (full source; BuildKit ccache) ---
FROM builder-deps AS builder
ARG UHD_VERSION
ARG DPDK_VERSION
ARG MARCH
ARG NUM_JOBS
ARG TARGETARCH
ARG COMPILER
ARG EXTRA_CMAKE_ARGS
ARG OCUDU_BUILD_TARGETS
# Full tree only here — one-line edits in lib/radio/null/ must not rebuild UHD/DPDK.
ADD external/proto-ru /src
# Mount BuildKit cache at /src/ccache (builder.sh -x ccache → CCACHE_DIR=$PWD/ccache).
RUN --mount=type=cache,id=openru-ccache,target=/src/ccache \
    ARCH_FLAG=$([ "${TARGETARCH}" = "arm64" ] && echo "-DMCPU=${MARCH}" || echo "-DMARCH=${MARCH}") \
    && /src/docker/scripts/builder.sh -c ${COMPILER} -x ccache -r False \
       -m "-j${NUM_JOBS} ${OCUDU_BUILD_TARGETS}" \
       -DBUILD_TESTING=False -DENABLE_UHD=On -DENABLE_DPDK=On ${ARCH_FLAG} -DCMAKE_INSTALL_PREFIX=/opt/ocudu \
       ${EXTRA_CMAKE_ARGS} /src
# Install whatever OCUDU_BUILD_TARGETS produced (compose needs gnb + ru_emulator).
RUN mkdir -p /opt/ocudu/bin && \
    cd /src/build && make install && \
    for pair in \
      "apps/cu/ocu:ocu" \
      "apps/du/odu:odu" \
      "apps/du_split_8/odu:odu_split_8" \
      "apps/du_split_7_2/odu:odu_split_7_2" \
      "apps/gnb/gnb:gnb" \
      "apps/gnb_split_8/gnb:gnb_split_8" \
      "apps/gnb_split_7_2/gnb:gnb_split_7_2" \
      "apps/examples/ofh/ru_emulator:ru_emulator"; do \
        src="${pair%%:*}"; dst="${pair##*:}"; \
        if [ -f "/src/build/${src}" ]; then cp "/src/build/${src}" "/opt/ocudu/bin/${dst}"; fi; \
      done && \
    test -x /opt/ocudu/bin/gnb && test -x /opt/ocudu/bin/ru_emulator && \
    rm -rf /src

# --- Runtime ---
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:12.6.0-runtime-ubuntu24.04
FROM ${CUDA_RUNTIME_IMAGE} AS runtime
ARG UHD_VERSION
ARG DPDK_VERSION
COPY --from=builder /opt/rohc                 /opt/rohc
COPY --from=builder /opt/uhd/${UHD_VERSION}   /opt/uhd/${UHD_VERSION}
COPY --from=builder /opt/dpdk/${DPDK_VERSION} /opt/dpdk/${DPDK_VERSION}
COPY --from=builder /opt/ocudu                /usr/local
COPY external/proto-ru/docker/scripts/install_rohc_dependencies.sh /usr/local/etc/install_rohc_dependencies.sh
COPY external/proto-ru/docker/scripts/install_uhd_dependencies.sh  /usr/local/etc/install_uhd_dependencies.sh
COPY external/proto-ru/docker/scripts/install_dpdk_dependencies.sh /usr/local/etc/install_dpdk_dependencies.sh
COPY external/proto-ru/docker/scripts/install_dependencies.sh      /usr/local/etc/install_ocudu_dependencies.sh
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/rohc/lib/
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/uhd/${UHD_VERSION}/lib/:/opt/uhd/${UHD_VERSION}/lib/x86_64-linux-gnu/:/opt/uhd/${UHD_VERSION}/lib/aarch64-linux-gnu/
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/dpdk/${DPDK_VERSION}/lib/:/opt/dpdk/${DPDK_VERSION}/lib/x86_64-linux-gnu/:/opt/dpdk/${DPDK_VERSION}/lib/aarch64-linux-gnu/
ENV PATH=$PATH:/opt/uhd/${UHD_VERSION}/bin/:/opt/dpdk/${DPDK_VERSION}/bin/
RUN /usr/local/etc/install_ocudu_dependencies.sh run && \
    /usr/local/etc/install_rohc_dependencies.sh run && \
    /usr/local/etc/install_uhd_dependencies.sh run && \
    /usr/local/etc/install_dpdk_dependencies.sh run && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl ntpdate iproute2 iputils-ping tcpdump && \
    apt-get autoremove && apt-get clean && rm -rf /var/lib/apt/lists/*
LABEL openru.gpu.lane="lab.env" \
      openru.build.cache="scripts-first+ccache"
