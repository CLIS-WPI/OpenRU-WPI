# Split stack, "core" host (DU + Open5GS). Loaded after docker/bench.env by scripts/split.sh.
# i9-10900X, 10 cores / 20 threads (siblings n and n+10), isolcpus=6-9,16-19,
# irqaffinity=0-5,10-15. One busy DU thread per physical core; HT siblings 16-19 stay idle.
SPLIT_FH_IFACE=ran_link
# Real-time DU threads on isolated 6-8; non-RT DU threads on housekeeping CPU 5.
DU_CPUSET=6-8
DU_CONTAINER_CPUSET=5-8
BENCH_DU_THREADS="ru_timing=6 ru_txrx_#0=7 main_pool#0=8 *=5"
CORE_CPUSET=0-4,10-15
# timer_migration stays as the host has it here until the split A/B with the DU on this host (bench.env sets 1).
BENCH_TM0=0
RT_WATCH_CPUS=0-1
