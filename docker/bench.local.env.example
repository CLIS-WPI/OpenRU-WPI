# Copy to docker/bench.local.env (gitignored). Never commit the copy.
#
# Host-specific remote access for shipping bench artifacts. `make bench-ship`
# reads HOST from this file when it is not set on the command line.
#
#   cp docker/bench.local.env.example docker/bench.local.env
#   # edit HOST / OPENRU_ARTIFACTS_DIR
#   make bench-ship

# SSH target as in ~/.ssh/config (a Host alias, not a Tailscale IP).  # no-secrets-ok
HOST=<bench-host>

# Where this machine stores bench-release tarballs (outside the git repo).
OPENRU_ARTIFACTS_DIR=<artifact-root>

# Directory name on the bench host under $HOME for the rsync destination.
BENCH_REMOTE_DIR=openru-artifacts
