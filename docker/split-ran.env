# Split stack, bench host (ProtO-RU only). Loaded after docker/bench.env by scripts/split.sh, so the values below
# override bench.env's single-host RU cpuset and thread plan.
# Fronthaul: X710 port 0, direct fibre to the core host (also carries PTP, 192.168.40.0/24).
SPLIT_FH_IFACE=enp5s0f0np0

# RU CPU plan for the split (the DU runs on the core host, so P-cores 8-11 are free here). Measured 2026-11-20
# (Phase D, docs/SPLIT_DU.md): with ru_radio on E-core 12 next to uhd_ctrl_ep0001 (UHD control, RR/89, busy-polls
# 100% of its CPU) and ~26 RR/89 gRPC threads, the RU hit a "Downlink data late" burst after 19 min; with the plan
# below the 60-minute run had 0 lower-PHY failures and three cold starts passed.
#   ru_radio_#0      UHD async-message loop, non-real-time by design (ProtO-RU)  -> P-core 8
#   ru_phy_ul_#0     uplink worker, FIFO                                          -> P-core 9 (HT sibling of 8)
#   uhd_ctrl_ep0001  UHD control endpoint, busy-polling RR/89                     -> E-core 12, alone
#   *                gRPC/event_engine, loggers, main threads                     -> E-core 13
# ru_radio and ru_phy_ul are also pinned by ru_cpus in the bench-split profiles; this plan applies and checks them.
PROTORU_CONTAINER_CPUSET=2-9,12,13
BENCH_RU_THREADS="ru_timing=2 ru_emu_#0=3 ru_rx_#0=4 ru_ofh_tx_#0=5 ru_phy_hp_#0=6 ru_phy_tx_#0=6 ru_phy_rx_#0=7 ru_radio_#0=8 ru_phy_ul_#0=9 uhd_ctrl_ep0001=12 *=13"
