# docker/bench.env — bench-bundle host configuration.
#
# Bench host (measured 2026-11-18): Intel Core i5-13600KF, 6 P-cores with HT +
# 8 E-cores, 20 logical CPUs, 31 GB RAM, no AVX-512, no NVIDIA GPU; Intel X710
# 4-port 10 GbE (radio link on enp5s0f1np1); Docker 29.6.1; kernel 7.0.0-28.
# Radio (default; BENCH_RADIO=n310-20|n310-30 overlays docker/radios/<radio>.env):
# N310-10, serial 33A6E56, IQ over SFP1 at 192.168.10.2 (stage 1 only;
# n310-20 at 192.168.20.2 / enp5s0f2np2 and n310-30 at 192.168.30.2 /
# enp5s0f3np3 exist for later stages).
#
# Compose usage on the bench host:
#   docker compose --env-file docker/bench.env \
#     -f docker/compose.yml -f docker/compose.cpu.yml <service ...>
#
# Core map (locked from the measured topology; see docs/BENCH_BUNDLE.md):
#   housekeeping/Open5GS/IRQs on 0-1 and 12-19, ProtO-RU on 2-7 (+ E-core 12),
#   DU on 8-11 (+ E-core 13) since 2026-11-20 (was 2-5 / 6-11);
#   kernel cmdline isolcpus=2-11 nohz_full=2-11 rcu_nocbs=2-11
#   irqaffinity=0-1,12-19 intel_idle.max_cstate=1 processor.max_cstate=1.
#   scripts/bench_preflight.sh fails closed on drift in the isolation trio.

# No NVIDIA GPU on the bench host: docker/compose.cpu.yml resets the protoru
# GPU pin. The base compose interpolates OPENRU_GPU_UUID before the overlay
# merge, so it must be set to a harmless non-empty value.
OPENRU_GPU_UUID=cpu-only

# Real-time lanes: isolated P-core logical CPUs only (HT siblings kept in same
# sets; checked by bench-preflight). Cores plan accepted 2026-11-20: ProtO-RU gets
# three physical cores (2/3, 4/5, 6/7), the DU two (8/9, 10/11).
PROTORU_CPUSET=2-7
DU_CPUSET=8-11
# Container cpusets = real-time lanes + one E-core each for the threads the
# applications do not pin (UHD control endpoint, gRPC, loggers, main threads).
PROTORU_CONTAINER_CPUSET=2-7,12
DU_CONTAINER_CPUSET=8-11,13
# Thread plan applied and checked after start (scripts/up.sh, scripts/restart_ru.sh
# via tools/bench/pin_threads.py). Read by bash only: the Makefile includes this file,
# and make treats "#" as a comment even inside quotes, so never use these in make.
# Format: name=cpu, "*" = every thread the application
# left unpinned. The config pins ru_timing/ru_phy_*/ru_radio (profiles) and the DU
# lanes (du-*.yml expert_execution); the three OFH threads share one ofh_cpus mask
# in ProtO-RU, so only this step can give each its own CPU.
BENCH_RU_THREADS="ru_timing=2 ru_emu_#0=3 ru_rx_#0=4 ru_ofh_tx_#0=5 ru_phy_hp_#0=6 ru_phy_tx_#0=6 ru_phy_rx_#0=7 ru_radio_#0=12 *=12"
BENCH_DU_THREADS="ru_timing=9 ru_txrx_#0=10 main_pool#0=11 *=13"
# Open5GS + core containers on the E-cores.
CORE_CPUSET=12-19

# v1 configuration for this host: FFTW + ESTIMATE, x86-64-v3 (no AVX-512).
MARCH=x86-64-v3
# UHD must match the N310 MPM (4.11.0.0-g0d7ed3b1, MPM version 7.0).
UHD_VERSION=4.11.0.0
# Release tag: `make bench-release` produces openru/protoru:bench-<sha> and
# the moving bench-latest; the bench host runs the tag it loaded.
OPENRU_TAG=bench-latest
PROTORU_SHM_SIZE=2gb

# Radio NIC: X710 port on the N310 management/IQ subnet (host address .1/24).
BENCH_FH_IFACE=enp5s0f1np1
BENCH_USRP_HOST_IP=192.168.10.1/24
# N310-10 (stage 1). Device args in profiles/bench-20mhz/protoru.yml.
# The profiles default REF=internal (N310 oscillator). REF=external is opt-in
# and selects only the OctoClock 10 MHz reference; time stays internal.
BENCH_USRP_SERIAL=33A6E56
BENCH_USRP_ADDR=192.168.10.2
BENCH_MGMT_ADDR=192.168.10.2
BENCH_UHD_VERSION=4.11.0.0

# UHD gain ranges measured on n310-10 (channels 0/1) with the in-container
# uhd_usrp_probe, 2026-11-19: TX 0.0-65.0 dB, RX 0.0-75.0 dB, step 0.5 dB.
# These are UHD gain values, not dBm (the datasheet warns they do not map to
# output power). bench-preflight checks the profile gains against the probe
# ranges and falls back to these values when the probe reports none.
BENCH_TX_GAIN_MIN=0
BENCH_TX_GAIN_MAX=65
BENCH_RX_GAIN_MIN=0
BENCH_RX_GAIN_MAX=75
BENCH_GAIN_STEP=0.5

# Bench e2e radio network (docker/compose.radio.yml): ProtO-RU gets a macvlan
# interface on the N310 subnet so UHD reaches 192.168.10.2 at MTU 9000 while the
# container stays on the Open Fronthaul bridge.
BENCH_RADIO_SUBNET=192.168.10.0/24
BENCH_RADIO_GATEWAY=192.168.10.1
BENCH_RU_IP=192.168.10.3
# Dedicated address for the throw-away UHD probe used by restart-ru while the
# RU is stopped. Never let Docker auto-assign .2 (the N310) on this macvlan.
BENCH_PROBE_IP=192.168.10.4
